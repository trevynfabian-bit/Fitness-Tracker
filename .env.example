# ---------------------------------------------------------------------------
# Supabase project settings -> API
# Both variables are validated at boot by src/lib/env.ts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute origin used for auth confirmation emails.
# Optional locally (derived from request headers); required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# The service role key is deliberately NOT part of the application environment.
# Nothing in the app is allowed to bypass RLS. Migrations and reference-data
# seeding use a privileged database connection outside the application.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Import worker (Phase 3). Server-only, validated lazily in
# src/lib/import/server-env.ts and never exposed to the browser.
#
# Normalization is the sanctioned canonical write path and the client roles hold
# SELECT only on canonical tables, so the worker needs the elevated key. It is
# read by the worker and by job enqueue, and by nothing else.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
IMPORT_WORKER_SECRET=a-long-random-string-the-cron-scheduler-sends
